VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_GITHUB_URL=
# Optional Cloudflare Web Analytics beacon token (public)
VITE_ANALYTICS_TOKEN=
# Canonical production origin, e.g. your actual HTTPS domain. Blank uses request origin.
VITE_SITE_URL=

# Enable only after SMTP and email confirmation are configured.
VITE_EMAIL_AUTH_ENABLED=false
# Explicit development-only UI demo; never enabled in production builds.
VITE_FRONTEND_DEMO=false

# Optional separate API origin (no trailing /api); empty uses same origin.
VITE_API_URL=
